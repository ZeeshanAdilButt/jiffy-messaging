{
  "name": "jiffy-messaging",
  "version": "0.1.0",
  "description": "Conversations and messages between users. Embed it as a package or run it as an HTTP and WebSocket service.",
  "keywords": [
    "messaging",
    "chat",
    "conversations",
    "websocket",
    "realtime",
    "postgres",
    "microservice",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeeshanAdilButt/jiffy-messaging.git"
  },
  "homepage": "https://github.com/ZeeshanAdilButt/jiffy-messaging#readme",
  "bugs": {
    "url": "https://github.com/ZeeshanAdilButt/jiffy-messaging/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/main.js",
    "schema:apply": "node scripts/apply-schema.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --exclude src/integration/**",
    "test:watch": "vitest",
    "test:integration": "vitest run src/integration",
    "example:embedded": "tsx examples/embedded.ts",
    "example:networked": "tsx examples/networked.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "tsup": "^8.3.5",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "ws": "^8.21.3"
  }
}
