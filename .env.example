# Production configuration for the standalone service. Copy to .env, which
# is gitignored, and fill in real values. Placeholders only in this file.
#
# These are every variable the process reads. DATABASE_URL, CORS_ORIGIN,
# PORT, the JWT_*/CONVERSATION_GATE_*/MESSAGE_NOTIFY_* sets, and REDIS_URL
# are parsed by parseEnv in src/main.ts; LOG_LEVEL is read by
# src/observability/logger.ts. Anything else is ignored.
#
# Full explanations in docs/deployment.md.

# Required. Postgres for this service's own database, not the one holding
# the platform's tables. sslmode=verify-full for any managed provider with
# a publicly trusted certificate; sslmode=require connects too but logs a
# deprecation warning on every start.
DATABASE_URL=postgres://jiffy:REPLACE_ME@db.example.com:5432/jiffy_messaging?sslmode=verify-full

# Required. Comma-separated list of browser origins allowed to call this
# service's REST surface. Every request the platform's web/mobile clients
# make here is cross-origin, and with no CORS configuration at all a browser
# blocks the request before it leaves the tab — no CORS headers ever appear,
# so the failure looks like a dead network connection, not a 401 or 500.
CORS_ORIGIN=https://www.goalslot.io

# Required unless JWT_JWKS_URI is set. The HMAC secret this service verifies
# bearer tokens against. Must be byte-identical to the secret the platform
# signs them with, and generated rather than chosen:
#   openssl rand -base64 48
JWT_SECRET=REPLACE_ME

# Alternative to JWT_SECRET, for a platform that rotates keys behind a JWKS
# endpoint. Wins if both are set, so do not leave a stale secret above
# expecting it to be a fallback.
# JWT_JWKS_URI=https://platform.example.com/.well-known/jwks.json

# Expected iss claim. Only checked when set, and strict once it is, so it
# has to match what the platform signs exactly.
JWT_ISSUER=platform-api

# Expected aud claim. Same rules as JWT_ISSUER.
JWT_AUDIENCE=jiffy-messaging

# Claim carrying the platform's user id. Defaults to sub. Leave commented
# out unless the platform puts it somewhere else.
# JWT_USER_ID_CLAIM=sub

# Listen port inside the container. Leave at 8080: the image's EXPOSE, the
# compose healthcheck, and the k8s probes all assume it. Remap on the host
# side instead if 8080 is taken there.
PORT=8080

# Required only to run more than one instance, and pointless before that.
# Without it, a message sent through one instance never reaches a client
# holding a socket on another.
# REDIS_URL=redis://redis.example.com:6379

# pino level: trace, debug, info, warn, error, fatal, silent. info gives one
# line per HTTP request plus WebSocket open and close.
LOG_LEVEL=info

# Optional, must be set together or not at all: a URL with no secret would
# call a host endpoint with no credential, a secret with no URL has nothing
# to send it to. Lets this service ask the platform whether two users are
# allowed to open a conversation before creating one. Unset means
# MessagingService's own default (any two callers may talk) applies.
# CONVERSATION_GATE_URL=https://api.goalslot.io/internal/messaging/can-message
# CONVERSATION_GATE_SECRET=REPLACE_ME

# Optional, must be set together or not at all, same rule as the gate pair
# above. Lets this service notify the platform when a new message arrives.
# Deliberately a separate secret from CONVERSATION_GATE_SECRET — this and the
# gate endpoint are different capabilities on the host, and a caller with one
# should not automatically have the other. Unset means MessagingService's own
# default (no notification) applies.
# MESSAGE_NOTIFY_URL=https://api.goalslot.io/internal/messaging/notify
# MESSAGE_NOTIFY_SECRET=REPLACE_ME
