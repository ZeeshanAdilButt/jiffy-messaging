# Template only - copy to secret.yaml, fill in real values, and apply that
# instead. secret.yaml is gitignored so a real one never gets committed.
#
# Set either JWT_SECRET or JWT_JWKS_URI, matching main.ts's parseEnv: a
# JWKS URI wins if both are present.
apiVersion: v1
kind: Secret
metadata:
  name: jiffy-messaging-secrets
type: Opaque
stringData:
  DATABASE_URL: "postgres://user:password@host:5432/jiffy_messaging"
  REDIS_URL: "redis://host:6379"
  JWT_SECRET: "replace-with-a-real-secret"
  # JWT_JWKS_URI: "https://platform.example.com/.well-known/jwks.json"
